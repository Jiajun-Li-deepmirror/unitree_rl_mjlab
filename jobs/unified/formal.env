# jobs/unified/formal.env (unitree-rl-mjlab-62 + go2-depth 2026-11-13; the user: a reproducible training pipeline, the
# recipe as code): the formal run's parameters, frozen with the commit. Sourced by teacher.sh, students.sh and
# accept.sh before their defaults; a variable already set in the environment (or a positional argument) wins, so
# probes and the smoke override what they need, and the formal launch sets nothing and names only the robot:
#   bash jobs/unified/teacher.sh Go2      bash jobs/unified/students.sh Go2
# The F_ prefix keeps these apart from the teacher's U_* training switches (none is set in a formal run: the frozen
# recipe's choices are the code's defaults) and from the scripts' own variables (teacher.sh's NUM_ENVS counts all
# seeds, students.sh's both students).

# the teacher (go2-depth's values, 11-13)
: "${F_TEACHER_SEEDS:=0 1}"          # two independent seeds from zero, side by side
: "${F_TEACHER_ITERS:=12000}"        # the cap; the gate ends a seed earlier
: "${F_TEACHER_PARALLEL:=1}"
: "${F_TEACHER_ENVS_PER_SEED:=2048}"
: "${F_GATE_EVERY_S:=900}"           # teacher.sh runs teacher_gate.py on each seed this often (s)
: "${F_GATE_HOLD:=500}"              # teacher_gate.py --hold: the window every bar must hold over (it)
: "${F_GATE_EVERY_IT:=100}"          # teacher_gate.py --every: judged at checkpoints this far apart (it)
: "${F_STAIRS_GATE:=1}"              # 1: teacher_gate.py --pre (the curriculum; the training's flat items too without
                                     # F_FLAT_GATE / --flat-tier2) then tier-2's stairs test on that
                                     # checkpoint (jobs/unified/stairs_gate.sh, scripts/unified/stairs_gate.py); 0: the
                                     # training's readings for every item (the gate before 11-13)
: "${F_STAIRS_GATE_PAY:=1}"          # a third stairs run: the seen mode with the walking payload, judged on its falls
: "${F_STAIRS_GATE_PAY_FALLS:=6}"    # its bar (traverse + stop of 576, ~1%), both robots: go2-depth's decision 11-13 --
                                     # the students' loaded stairs are judged at 0 falls, so a teacher at 4-8% would only
                                     # fail its students 7000 iterations later; the delivered models are no reference
                                     # under load (v4 never trained at 8 kg: 687; the delivered Go2W: 47)
: "${F_STAIRS_GATE_TYP:=1}"          # two more stairs runs, both scan modes with the typical payload (4 kg, its mount
                                     # drawn per robot), judged as the students' typical condition judges its stairs at
                                     # the teacher's tolerances (falls <= 2 per mode; speed >= 80% of the same mode's
                                     # unloaded run per band). 11-13: Go2 s38 6097 fell 43 / 27, Go2W s28 4997 (every
                                     # unloaded stairs item passed) 11 / 24 there -- their students take no fall at it
: "${F_STAIRS_GATE_GAP:=500}"        # a seed's stairs judged again only this many iterations after its last judged one
: "${F_FLAT_GATE:=1}"                # 1 (go2-depth's decision 11-13): after the stairs pass, tier-2's own flat tests on that
                                     # checkpoint (jobs/unified/flat_gate.sh, scripts/unified/flat_gate.py): both scan
                                     # modes, the students' flat bars, no flat fall; teacher_gate.py --pre leaves the
                                     # training's flat items unjudged (--flat-tier2) -- they read about half of tier 2's
: "${F_FLAT_GATE_DRIFT_ENVS:=384}"   # drift_all robots per command (accept.sh 768; the user's floor 256): beside the
                                     # formal run's two seeds (14.1 GB), +4.2-5.2 GB at 384 (11-13)
: "${F_FLAT_GATE_STAND_ENVS:=384}"   # eval_standing robots per group (+2.3 GB at 384)
: "${F_FLAT_GATE_STANCE_ENVS:=384}"  # long_stand and stop_then_move robots (the zero-command stance)
: "${F_FLAT_GATE_FREE_MB:=6500}"     # a flat test starts only with this much free on the card (the largest test's peak
                                     # +5.2 GB with a margin): it must never take a training down (11-13: one did)
: "${F_FLAT_GATE_WAIT_S:=1800}"      # no room that long: a tool fault, judged again at the next gate

# the students (P3 11-12: 1024 each side by side fit an empty card, 16.5 GB; both teacher seeds stopped first)
: "${F_STUDENT_S1_ITERS:=4000}"
: "${F_STUDENT_S2_ITERS:=3000}"
: "${F_STUDENT_ENVS_EACH:=1024}"
: "${F_STUDENT_SEED:=0}"
# the stages by progress (2026-11-13, go2-depth; the user 10-30: a stage that passes early ends, the next starts at
# once). F_STUDENT_S1_ITERS / F_STUDENT_S2_ITERS above are the caps. Values provisional until #3's stage-1 curve.
: "${F_S1_MIN_ITERS:=1000}"          # stage 1 (DAgger) ends on its behavior loss levelling off, not before this
: "${F_S1_CHECK_EVERY_IT:=100}"      # judged at every checkpoint (the runner saves every 100)
: "${F_S1_PLATEAU_WINDOW:=200}"      # the last WINDOW iterations' mean loss against the WINDOW before them
: "${F_S1_PLATEAU_DROP:=0.05}"       # fell less than this (relative) ...
: "${F_S1_PLATEAU_HOLD:=2}"          # ... at this many checks in a row -> stage 2 from that checkpoint
: "${F_S2_GATE_EVERY_IT:=500}"       # stage 2's gates: the students' tier 2 every this many iterations (0: off)
: "${F_S2_GATE_AVG_N:=8}"            # on the average of the newest N checkpoints (the acceptance's candidate); a point
                                     # with fewer saved is skipped (500 has 6 at a save every 100: the first is 1000)
: "${F_S2_GATE_NEED_MB:=stairs:2500 loadstand:4000 stopmove:3000 drift3:7000 spinalt:3500 stand:5500 march:2500 am:4500 clock:3500 gait:3500 noop:4500 op:4500 *:6000}"
                                     # one test at a time beside the training, each starting only with its need free
                                     # (MiB; peak + ~1.5 GB, provisional: the gates log each test's peak in its .peak
                                     # file); the drift in two halves of 7 / 6 commands (13 x 768 robots ~9-10 GB do
                                     # not fit the ~8 GB two students leave of 24.5 GB)
: "${F_S2_GATE_WAIT_S:=1800}"        # a test without room that long: a tool fault of that gate, training goes on
: "${F_FALLBACK_TEACHER_CAP:=12000}" # a fallback teacher seed resumes to this total

# the acceptance
: "${F_ACCEPT_CANDIDATES:=avg}"      # one candidate: the mean of the AVG_N newest stage-2 checkpoints
: "${F_ACCEPT_AVG_N:=8}"
: "${F_ACCEPT_JOBS:=2}"
